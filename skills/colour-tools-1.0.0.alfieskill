{"format":"alfie-skill","formatVersion":1,"manifest":{"id":"colour-tools","name":"Colour tools","version":"1.0.0","author":"Alfie","description":"Converts colours between hex, RGB and HSL (and CSS colour names), checks text contrast against the WCAG accessibility guidelines, and makes palettes: tints and shades, complementary, triadic and analogous colours. Handy for design and web work.","entry":"index.js","permissions":[],"tools":[{"name":"convert_colour","description":"Show a colour as hex, RGB and HSL, and its nearest CSS colour name. Accepts #rgb, #rrggbb, rgb(…), hsl(…) or a CSS name like teal.","parameters":{"type":"object","properties":{"colour":{"type":"string"}},"required":["colour"]},"risk":"read"},{"name":"contrast_check","description":"The contrast ratio between text and background colours, and whether it passes WCAG AA and AAA for normal and large text.","parameters":{"type":"object","properties":{"text":{"type":"string"},"background":{"type":"string"}},"required":["text","background"]},"risk":"read"},{"name":"make_palette","description":"Make a palette from a colour: shades (lighter to darker), complementary, triadic, analogous, or split (split-complementary).","parameters":{"type":"object","properties":{"colour":{"type":"string"},"kind":{"type":"string","enum":["shades","complementary","triadic","analogous","split"]}},"required":["colour","kind"]},"risk":"read"}]},"files":{"index.js":"","skill.json":"","tests.json":""},"digest":"177876ce8d2bb607b830f41559ba57c1015419953580993c5284667c1b52a4d3","signature":{"publicKey":"MCowBQYDK2VwAyEAT33O5nLtA0RUeG67IfOMOoPuwt28TTobyvO2C6vmN0g=","value":"mSUNsHKPa5v02qy7Jv4jMXjy0rO1axlkEsRkH0bJuM7iH0tugSN9rr69+jPSOEeqEWYAbLRGVd2PC8ZfGmB0AQ=="}}