{"format":"alfie-skill","formatVersion":1,"manifest":{"id":"unit-converter","name":"Unit converter","version":"1.0.0","author":"Alfie","description":"Converts lengths, weights, temperatures and volumes, and counts the days between two dates. An example of an Alfie skill: it needs no permissions at all.","entry":"index.js","permissions":[],"tools":[{"name":"convert_units","description":"Convert a number from one unit to another. Units: mm, cm, m, km, in, ft, yd, mi; mg, g, kg, oz, lb, st; C, F, K; ml, l, tsp, tbsp, cup, floz, pt, qt, gal.","parameters":{"type":"object","properties":{"value":{"type":"number"},"from":{"type":"string","description":"Unit to convert from, e.g. km"},"to":{"type":"string","description":"Unit to convert to, e.g. mi"}},"required":["value","from","to"]},"risk":"read"},{"name":"days_between","description":"How many days there are between two dates (YYYY-MM-DD).","parameters":{"type":"object","properties":{"start":{"type":"string","description":"First date, YYYY-MM-DD"},"end":{"type":"string","description":"Second date, YYYY-MM-DD"}},"required":["start","end"]},"risk":"read"}],"prompt":"Use convert_units for unit conversions instead of working them out yourself."},"files":{"index.js":"","skill.json":""},"digest":"6d9ba994a29dade45b07c3f319fb5fd8ca38f7c1923c675557472f43e72243e6","signature":{"publicKey":"MCowBQYDK2VwAyEAT33O5nLtA0RUeG67IfOMOoPuwt28TTobyvO2C6vmN0g=","value":"rqUCuP9FdZgclUv4OO3l2xCIjdVKp399MM5V4tohxXgjnjxcUKlH31CGU5MbthunYpo6U8pimHY/22mb7B56Bw=="}}